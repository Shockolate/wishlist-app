{
  "name": "@wishlist/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@node-rs/argon2": "2.2.2",
    "@sentry/node": "11.8.0",
    "@vercel/functions": "3.9.11",
    "@wishlist/contracts": "workspace:*",
    "drizzle-orm": "0.45.3",
    "entities": "8.1.0",
    "express": "5.2.1",
    "htmlparser2": "12.0.0",
    "ipaddr.js": "2.5.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "undici": "8.11.2",
    "uuid": "14.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.2",
    "@swc/core": "1.16.18",
    "@testcontainers/postgresql": "12.2.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@wishlist/config": "workspace:*",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "supertest": "7.3.1",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3",
    "undici-types": "7.24.6",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.3"
  }
}
